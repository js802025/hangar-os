[Unit]
Description=Install the Zed editor (Hangar's code-review editor) from Flathub
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/app/dev.zed.Zed

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
ExecStart=/usr/bin/flatpak install --system --noninteractive --assumeyes flathub dev.zed.Zed
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
