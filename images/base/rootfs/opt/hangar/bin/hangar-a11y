#!/usr/bin/python3
"""Read and drive desktop apps through the accessibility tree (AT-SPI).

The desktop-app version of browser_snapshot: lists windows' buttons, menus,
text fields and so on as numbered lines, and acts on them by number.
GTK and Qt apps and LibreOffice expose this tree; xterm and canvases don't.

  hangar-a11y snapshot [app-name-filter]
  hangar-a11y click <ref>
  hangar-a11y type <ref> <text>         (focus it, then type like a keyboard)
  hangar-a11y set <ref> <text>          (replace an editable field's text)
  hangar-a11y read <ref>                (full text of an element)

Runs on the system Python (python3-gi), separate from the MCP server's venv.
Refs are only valid until the next snapshot.
"""

import json
import os
import subprocess
import sys
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

REFS = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"hangar-a11y-{os.getuid()}.json")
MAX_NODES, MAX_DEPTH = 300, 40
ACTIONABLE = {"push button", "toggle button", "check box", "radio button", "menu item", "check menu item",
              "radio menu item", "menu", "combo box", "list item", "page tab", "link", "entry", "text",
              "password text", "spin button", "slider", "tree item", "table cell", "icon", "tool bar item",
              "document text", "document frame", "paragraph", "terminal"}
CONTEXT = {"heading", "label", "status bar", "alert", "dialog", "notification"}
EDITABLE = {"entry", "text", "password text", "document text", "paragraph", "spin button", "terminal"}


def text_of(acc, limit=120):
    try:
        if acc.get_text_iface() is None:
            return ""
        n = Atspi.Text.get_character_count(acc)
        s = (Atspi.Text.get_text(acc, 0, min(n, max(limit, 4000))) or "").strip().replace("\n", " ⏎ ")
        return s[:limit] + ("…" if len(s) > limit else "")
    except Exception:
        return ""


def deep_text(acc, limit=20000):
    """Text of a container (e.g. a document) = its paragraphs' text, in order."""
    out, stack = [], [acc]
    while stack and sum(map(len, out)) < limit:
        a = stack.pop()
        t = text_of(a, limit=limit) if a is not acc else ""
        if t:
            out.append(t.replace(" ⏎ ", "\n"))
            continue
        try:
            stack.extend(a.get_child_at_index(i) for i in range(min(a.get_child_count(), 2000) - 1, -1, -1))
        except Exception:
            pass
    return "\n".join(x for x in out if x)[:limit]


def states(acc):
    try:
        ss = acc.get_state_set()
    except Exception:
        return set()
    names = {Atspi.StateType.FOCUSED: "focused", Atspi.StateType.CHECKED: "checked",
             Atspi.StateType.SELECTED: "selected", Atspi.StateType.EXPANDED: "expanded",
             Atspi.StateType.EDITABLE: "editable"}
    out = {v for k, v in names.items() if ss.contains(k)}
    if not ss.contains(Atspi.StateType.ENABLED):
        out.add("disabled")
    if not ss.contains(Atspi.StateType.SHOWING):
        out.add("hidden")
    return out


def snapshot(filt=""):
    desktop = Atspi.get_desktop(0)
    lines, refs, n = [], {}, 0
    for ai in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(ai)
        if app is None:
            continue
        aname = app.get_name() or ""
        if filt and filt.lower() not in aname.lower():
            continue
        for wi in range(app.get_child_count()):
            win = app.get_child_at_index(wi)
            if win is None or "hidden" in states(win):
                continue
            lines.append(f'window "{win.get_name()}" (app {aname})')
            stack = [(win, [ai, wi], 0)]
            count = 0
            while stack and count < MAX_NODES:
                acc, path, depth = stack.pop()
                try:
                    role = acc.get_role_name()
                    kids = acc.get_child_count()
                except Exception:
                    continue
                st = states(acc)
                if acc is not win and "hidden" not in st:
                    name = (acc.get_name() or "").strip()[:100]
                    if role in ACTIONABLE or (role in CONTEXT and name):
                        val = text_of(acc) if role in EDITABLE else ""
                        if role in ACTIONABLE:
                            n += 1
                            refs[str(n)] = path
                            line = f'  [{n}] {role} "{name}"'
                        else:
                            line = f'  {role}: {name}'
                        if val:
                            line += f' value="{val}"'
                        flags = sorted(st - {"hidden"})
                        if flags:
                            line += " (" + ", ".join(flags) + ")"
                        lines.append(line)
                        count += 1
                if depth < MAX_DEPTH and "hidden" not in st:
                    for ci in range(min(kids, 500) - 1, -1, -1):
                        try:
                            ch = acc.get_child_at_index(ci)
                        except Exception:
                            continue
                        if ch is not None:
                            stack.append((ch, path + [ci], depth + 1))
            if stack:
                lines.append("  … more elements not shown (close panels or narrow with an app filter)")
    with open(REFS, "w") as f:
        json.dump(refs, f)
    return "\n".join(lines) if lines else ("(no accessible windows" + (f' for "{filt}"' if filt else "") + ")")


def resolve(ref):
    try:
        path = json.load(open(REFS))[str(ref)]
    except (OSError, ValueError, KeyError):
        raise SystemExit(f"no element [{ref}]; run app_snapshot first")
    acc = Atspi.get_desktop(0)
    for i in path:
        acc = acc.get_child_at_index(i) if acc else None
    if acc is None:
        raise SystemExit(f"element [{ref}] is gone; run app_snapshot again")
    return acc


def click(acc):
    if acc.get_action_iface() is not None and Atspi.Action.get_n_actions(acc):
        names = [Atspi.Action.get_action_name(acc, i) for i in range(Atspi.Action.get_n_actions(acc))]
        for want in ("click", "press", "activate", "toggle", "jump", "open"):
            if want in names:
                Atspi.Action.do_action(acc, names.index(want))
                return f"{want}ed" if not want.endswith("e") else f"{want}d"
        Atspi.Action.do_action(acc, 0)
        return f"did {names[0]}"
    if acc.get_component_iface() is not None:
        ext = Atspi.Component.get_extents(acc, Atspi.CoordType.SCREEN)
        x, y = ext.x + ext.width // 2, ext.y + ext.height // 2
        subprocess.run(["xdotool", "mousemove", "--sync", str(x), str(y), "click", "1"], check=True)
        return f"clicked at ({x}, {y})"
    raise SystemExit("can't click that element")


def focus(acc):
    if acc.get_component_iface() is not None and Atspi.Component.grab_focus(acc):
        return
    click(acc)


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    cmd = sys.argv[1]
    if cmd == "snapshot":
        print(snapshot(sys.argv[2] if len(sys.argv) > 2 else ""))
    elif cmd == "click":
        print(click(resolve(sys.argv[2])))
    elif cmd in ("type", "set"):
        acc, text = resolve(sys.argv[2]), " ".join(sys.argv[3:])
        if cmd == "set":
            if acc.get_editable_text_iface() is not None and Atspi.EditableText.set_text_contents(acc, text):
                print(f"set {len(text)} characters")
                return
        focus(acc)
        subprocess.run(["xdotool", "type", "--delay", "12", "--", text], check=True)
        print(f"typed {len(text)} characters")
    elif cmd == "read":
        acc = resolve(sys.argv[2])
        print(text_of(acc, limit=20000) or deep_text(acc) or (acc.get_name() or ""))
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main()
